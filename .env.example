# Q2Q configuration. Copy to `.env` and fill in.
#
#     cp .env.example .env
#
# This file is the authoritative list of every environment variable the code
# reads. Defaults shown are the ones hardcoded in src/config.py; a variable
# left unset falls back to that default.
# Never commit a filled-in `.env` -- it is gitignored for that reason.

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai                     # openai | anthropic
DEFAULT_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Only needed when LLM_PROVIDER=anthropic (requires `pip install anthropic`).
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Azure OpenAI, read only when the Azure client path is selected.
# AZURE_OPENAI_API_KEY=your_azure_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# Transport and retry behaviour of the LLM client.
# LLM_STREAM=true                       # false forces blocking completions
# LLM_MAX_RETRIES=10
# LLM_RETRY_MIN_DELAY=10.0
# LLM_RETRY_MAX_DELAY=20.0

# ---------------------------------------------------------------------------
# Asset roots
# ---------------------------------------------------------------------------
# All model and dataset locations in this repo are relative to these two roots,
# so nothing is tied to one machine. Defaults: <project_root>/models and
# <project_root>/data. Point them elsewhere for a shared cache or a mount.
# MODELS_DIR=/path/to/your/models
# DATA_DIR=/path/to/your/datasets

# ---------------------------------------------------------------------------
# Embedding
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=local                # local | openai
# A bare directory name is resolved under MODELS_DIR; an absolute path is used
# as-is. For EMBEDDING_PROVIDER=openai, give an API model id instead
# (e.g. text-embedding-3-small).
DEFAULT_EMBEDDING_MODEL=bge-large-en-v1.5
EMBEDDING_DEVICE=cpu                    # cpu | cuda | mps

# ---------------------------------------------------------------------------
# Preprocessing
# ---------------------------------------------------------------------------
PROPOSITION_MODE=llm                    # llm | nlp
# `nlp` additionally requires sentencepiece; see requirements.txt.
# Both resolve under MODELS_DIR when given as a bare name.
# COMPRESSOR_MODEL=Qwen2.5-0.5B-Instruct
# NLP_INFERENCE_MODEL=flan-t5-large
# COMPRESSOR_DEVICE=cpu

# ---------------------------------------------------------------------------
# Memory construction / retrieval
# ---------------------------------------------------------------------------
FQ_STYLE=formal                         # formal | colloquial | keyword | elliptical
FQ_ROLE=user                            # user | otherside
# Weight of the anchor query when scoring the focus window (src/retrieval/focus.py).
# Q2Q_ANCHOR_WEIGHT=0.5

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
STORAGE_CHROMADB_PATH=data/chromadb
STORAGE_CHROMADB_COLLECTION=q2q_memories

# ---------------------------------------------------------------------------
# Logging and output
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
OUTPUT_DIR=outputs

# ---------------------------------------------------------------------------
# Probe scripts (experiment/probe/, used for diagnostics only)
# ---------------------------------------------------------------------------
# PROBE_BUDGET=10000                    # focus-window token budget under test
