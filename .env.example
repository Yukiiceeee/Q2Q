# LLM API
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_BASE=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gpt-4o-mini

# Judge Model Settings (for evaluation metrics)
JUDGE_MODEL=gpt-4o-mini
JUDGE_API_KEY=your_judge_api_key_here
JUDGE_BASE_URL=https://api.openai.com/v1

# Zep Cloud API Key
ZEP_API_KEY=your_zep_api_key_here

# Embedding Settings
# Option 1: OpenAI API
# DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_PROVIDER=openai

# Option 2: Local Embedding
DEFAULT_EMBEDDING_MODEL=/path/to/your/embedding/model
EMBEDDING_PROVIDER=local

LOG_LEVEL=INFO

# Storage paths
STORAGE_CHROMADB_PATH=data/chromadb
STORAGE_CHROMADB_COLLECTION=q2q_memories
STORAGE_JSON_PATH=data/memories.json

# Logging
LOG_DIR=logs
OUTPUT_DIR=outputs
