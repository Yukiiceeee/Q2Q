.env
.env.local
.env.*.local
*.pem
*.key
!.env.example

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
ENV/
env/

# ---------------------------------------------------------------------------
# Editors / IDE
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Datasets and model weights
# ---------------------------------------------------------------------------
# Third-party corpora are never committed; see DATASETS.md for how to fetch
# them. LoCoMo in particular is CC BY-NC 4.0, and anything generated from it
# inherits that restriction.
data/
models/

# ---------------------------------------------------------------------------
# Runtime output
# ---------------------------------------------------------------------------
logs/
outputs/
*.log

# ---------------------------------------------------------------------------
# Experiment artifacts
# ---------------------------------------------------------------------------
# Everything below is regenerated by `python experiment/run.py`. None of it is
# source: the stores are hundreds of megabytes of binary embeddings derived
# from licensed corpora, and the results and figures are run output that would
# otherwise churn in every diff.
experiment/store/*/
experiment/results/
experiment/figs/
experiment/generation/outputs/
experiment/.emb_cache/
*.npy

# ---------------------------------------------------------------------------
# Tooling scratch
# ---------------------------------------------------------------------------
.playwright-mcp/
.spec-workflow/
.claude/

# ---------------------------------------------------------------------------
# Manuscript drafts
# ---------------------------------------------------------------------------
# Paper text is kept out of the public repo while under double-blind review.
paper.txt
paper/
*.aux
*.bbl
*.blg
*.synctex.gz

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
